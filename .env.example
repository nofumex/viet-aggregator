POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://aggregator:change-me@localhost:5432/telegram_aggregator?sslmode=disable
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789

# OpenAI-compatible endpoint. Used only when a source is added or an admin
# explicitly requests re-analysis. Never used for individual messages/syncs.
BASE_URL=http://127.0.0.1:3001/v1
FREE_LLM_API_KEY=
LLM_PROFILE_MODEL=gpt-oss-20b
LLM_PROFILE_TIMEOUT=45s

HTTP_ADDR=:8080
DB_MAX_CONNS=5
DB_MIN_CONNS=1
DB_BACKGROUND_MAX_CONNS=2
DEFAULT_POLL_INTERVAL=5m
SYNC_CONCURRENCY=3
RERANK_INTERVAL=15m
RERANK_BATCH=100
COLLECTION_REFRESH_INTERVAL=10m
COLLECTION_REFRESH_TIMEOUT=90s

# MTProto API ID / Hash are configured in Admin → Telegram Account. The
# built-in defaults are API_ID=2040 and the official Telegram desktop API hash;
# both can be changed in the bot UI.
